<%- include('../layouts/header') %>

<section class="dashboard-section">
  <div class="container">
    <div class="dashboard-header">
      <div>
        <h1 class="dashboard-title">Welcome back, <span class="accent-text"><%= user ? user.name : 'User' %></span>!</h1>
        <p class="dashboard-subtitle">Manage, create, and polish your professional resumes</p>
      </div>
      <a href="/resume/create" class="btn btn-primary">+ Create New Resume</a>
    </div>

    <% if (typeof error !== 'undefined' && error) { %>
      <div class="alert alert-error">
        <span><%= error %></span>
      </div>
    <% } %>

    <% if (resumes && resumes.length > 0) { %>
      <div class="resume-grid">
        <% resumes.forEach(resume => { %>
          <div class="resume-card">
            <div class="resume-card-header">
              <h3 class="resume-card-title"><%= resume.title %></h3>
              <span class="resume-card-date">Updated: <%= new Date(resume.updatedAt).toLocaleDateString() %></span>
            </div>
            <div class="resume-card-body">
              <p><strong>Name:</strong> <%= resume.fullName %></p>
              <p><strong>Email:</strong> <%= resume.email %></p>
              <% if (resume.summary) { %>
                <p class="resume-summary-preview"><%= resume.summary.substring(0, 100) %><% if (resume.summary.length > 100) { %>...<% } %></p>
              <% } %>
            </div>
            <div class="resume-card-actions">
              <a href="/resume/<%= resume.id %>" class="btn btn-sm btn-secondary">View</a>
              <a href="/resume/<%= resume.id %>/edit" class="btn btn-sm btn-outline">Edit</a>
              <form action="/resume/<%= resume.id %>/delete" method="POST" onsubmit="return confirm('Are you sure you want to delete this resume?');" class="inline-form">
                <button type="submit" class="btn btn-sm btn-danger">Delete</button>
              </form>
            </div>
          </div>
        <% }); %>
      </div>
    <% } else { %>
      <div class="empty-state">
        <div class="empty-icon">📄</div>
        <h2>No Resumes Created Yet</h2>
        <p>Start creating your first professional, ATS-optimized resume right now.</p>
        <a href="/resume/create" class="btn btn-primary">Build Your First Resume</a>
      </div>
    <% } %>
  </div>
</section>

<%- include('../layouts/footer') %>
