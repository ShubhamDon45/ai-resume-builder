<%- include('../layouts/header') %>

<section class="auth-section">
  <div class="container auth-container">
    <div class="auth-card">
      <div class="auth-header">
        <h2>Create an Account</h2>
        <p>Join ResuCraft AI to start building professional resumes</p>
      </div>

      <% if (typeof error !== 'undefined' && error) { %>
        <div class="alert alert-error">
          <span><%= error %></span>
        </div>
      <% } %>

      <form action="/auth/register" method="POST" class="auth-form">

        <!-- Full Name -->
        <div class="form-group">
          <label for="name">Full Name</label>
          <input
            type="text"
            id="name"
            name="name"
            class="form-control"
            placeholder="John Doe"
            value="<%= typeof formData !== 'undefined' && formData.name ? formData.name : '' %>"
            required
          >
        </div>

        <!-- Email -->
        <div class="form-group">
          <label for="email">Email Address</label>
          <input
            type="email"
            id="email"
            name="email"
            class="form-control"
            placeholder="example@gmail.com"
            value="<%= typeof formData !== 'undefined' && formData.email ? formData.email : '' %>"
            pattern="^[a-zA-Z0-9._%+-]+@gmail\.com$"
            title="Please enter a valid Gmail address"
            required
          >
        </div>

        <!-- Password -->
        <div class="form-group">
          <label for="password">Password</label>
          <input
            type="password"
            id="password"
            name="password"
            class="form-control"
            placeholder="••••••••"
            required
          >
        </div>

        <button type="submit" class="btn btn-primary btn-block">
          Register Account
        </button>

      </form>

      <div class="auth-footer">
        <p>
          Already have an account?
          <a href="/auth/login" class="auth-link">Sign in here</a>
        </p>
      </div>
    </div>
  </div>
</section>

<%- include('../layouts/footer') %>