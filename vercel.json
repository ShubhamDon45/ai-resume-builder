{
  "buildCommand": "cd resume-builder && npm install && npx prisma generate",
  "outputDirectory": "resume-builder",
  "framework": "express",
  "functions": {
    "resume-builder/server.js": {
      "runtime": "nodejs18.x"
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}
